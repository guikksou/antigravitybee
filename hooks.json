{
  "bee-companion": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "python ./skills/bee/scripts/bee_hook.py",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python ./skills/bee/scripts/bee_hook.py",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python ./skills/bee/scripts/bee_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python ./skills/bee/scripts/bee_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python ./skills/bee/scripts/bee_hook.py",
        "timeout": 5
      }
    ]
  }
}
